    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.jpg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.geekspark.gsnews"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-font"],
    "extra": {
      "eas": {
        "projectId": "c0a8c041-72c9-4cc2-89f2-e1a15ae7ba59"
      }
    },
    "owner": "uxverse-studio"
  }
