{
  "expo": {
    "name": "VenezuelaNews",
    "slug": "venezuelanews",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
